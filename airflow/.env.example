# Copie este archivo como airflow/.env y ajuste. Todos los valores son opcionales.
# En Linux (incluido GitHub Codespaces) use el resultado de `id -u`, para que los contenedores
# puedan escribir en data/ y reports/ del repositorio. En Windows y macOS con Docker Desktop no importa.
AIRFLOW_UID=50000

# Reintentos (backoff exponencial): esperas ~60 s, 120 s, 240 s, tope 600 s
DATAMARCA_RETRIES=3
DATAMARCA_RETRY_DELAY_SEG=60
DATAMARCA_MAX_RETRY_DELAY_SEG=600

# Compuerta de calidad: % de rechazo por fuente que detiene la corrida
UMBRAL_RECHAZO_PCT=0.1

# Retención de la zona de trabajo data/_staging/<corrida>/ (docs/orquestacion/manejo_errores_logging.md, sección 5)
# true = al terminar una corrida EXITOSA se borran sus intermedios (se conservan estado/ y metricas/).
# Las corridas fallidas se conservan completas para investigarlas o reanudarlas.
DATAMARCA_LIMPIAR_STAGING=true
# Días que se conserva la carpeta de cualquier corrida antes de borrarla. 0 = no se purga.
DATAMARCA_RETENCION_DIAS=7

# Demostración de fallo (T1.3): fuerza el fallo de una tarea intermedia
# DATAMARCA_FALLAR_EN=limpiar_logs
# DATAMARCA_FALLAR_INTENTOS=999

# Prueba de timeouts (T1.3): demora una tarea más que su execution_timeout (<tarea>:<segundos>)
# y, si se quiere probar el límite de la corrida completa, lo baja (por defecto 60 min)
# DATAMARCA_DEMORAR_EN=compuerta_calidad:300
# DATAMARCA_DAGRUN_TIMEOUT_MIN=60

# Notificación opcional (Slack/Teams/genérico)
# DATAMARCA_WEBHOOK_URL=
