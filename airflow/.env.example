# Copie este archivo como airflow/.env y ajuste. Todos los valores son opcionales.
AIRFLOW_UID=50000

# Reintentos (backoff exponencial): esperas ~60 s, 120 s, 240 s, tope 600 s
DATAMARCA_RETRIES=3
DATAMARCA_RETRY_DELAY_SEG=60
DATAMARCA_MAX_RETRY_DELAY_SEG=600

# Compuerta de calidad: % de rechazo por fuente que detiene la corrida
UMBRAL_RECHAZO_PCT=0.1

# Demostración de fallo (T1.3): fuerza el fallo de una tarea intermedia
# DATAMARCA_FALLAR_EN=limpiar_logs
# DATAMARCA_FALLAR_INTENTOS=999

# Notificación opcional (Slack/Teams/genérico)
# DATAMARCA_WEBHOOK_URL=
