# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# --- Spark / Hadoop (archivos que genera Spark al ejecutarse) ---
spark-warehouse/
metastore_db/
derby.log
.hadoop/

# --- Salidas generadas por el pipeline ---
# La cuarentena y las métricas de calidad se regeneran en cada ejecución.
data/quarantine/
# Ejecutar `python main.py` desde src/ crea src/data/; la salida oficial es data/processed/ (raíz).
src/data/
# Archivos auxiliares que Spark escribe junto a cada Parquet (no se necesitan para leer los datos)
*.crc
_SUCCESS
_temporary/

# Logs de tiempos de cada ejecución (tarea 5.2). Solo se versionan las corridas elegidas como
# evidencia, copiadas a reports/tiempos/evidencia/.
reports/tiempos/*
!reports/tiempos/evidencia/
!reports/tiempos/README.md
# Zona de trabajo y resúmenes de cada corrida del DAG (Unidad 4). Solo se versionan las corridas
# elegidas como evidencia, copiadas a reports/orquestacion/evidencia/.
data/_staging/
reports/orquestacion/resumen_*

# --- Credenciales y configuración local (nunca se versionan) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log

# --- Editores y sistema operativo ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# Archivos locales generados según README (Databricks y descarga de tiempos)
/job_listo.json
/tmp_tiempos/

# Registro persistente local de alertas: separado del staging y de su retención.
/data/alert_state/
